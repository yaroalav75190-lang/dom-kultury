# Заголовки ответа. Формат понимают Netlify и Cloudflare Pages.
# Для nginx или Apache те же правила нужно перенести руками —
# см. раздел «Публикация» в README.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # Строгий CSP тут невозможен без хешей: Astro встраивает небольшой
  # инлайновый скрипт и стили компонентов. Но даже такая политика
  # отсекает подгрузку чужих скриптов и отправку данных на чужие домены.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src https://yandex.ru https://*.yandex.ru; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'

# В именах файлов сборки есть хеш содержимого — их можно держать вечно.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Иконки меняются редко, но имя у них постоянное.
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/og.jpg
  Cache-Control: public, max-age=604800

# HTML должен обновляться сразу после публикации новой афиши.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/afisha/rss.xml
  Cache-Control: public, max-age=1800
