---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import EventCard from '@/components/EventCard.astro';
import Marquee from '@/components/Marquee.astro';
import SignatureDrinks from '@/components/SignatureDrinks.astro';
import Occasions from '@/components/Occasions.astro';
import Proof from '@/components/Proof.astro';
import Offers from '@/components/Offers.astro';
import OpenStatus from '@/components/OpenStatus.astro';
import { site } from '@/data/site';
import { eventIsUpcoming, plural, formatDay } from '@/lib/datetime';

import interiorHall from '@/assets/brand/interior-hall.png';
import interiorTable from '@/assets/brand/interior-table.jpg';
import { withBase } from '@/lib/url';

const events = (await getCollection('events', ({ data }) => !data.draft))
  .filter((e) => eventIsUpcoming(e.data))
  .sort((a, b) => {
    if (!a.data.startsAt) return 1;
    if (!b.data.startsAt) return -1;
    return a.data.startsAt.getTime() - b.data.startsAt.getTime();
  });

const nextUp = events.slice(0, 3);

const ticker = [
  'концерты',
  'квартирники',
  'dj-сеты',
  'музыкальное лото',
  'театральные постановки',
  'иммерсивный театр',
  'гастроужины',
  'авторские коктейли',
  'летняя веранда',
  'мастер-классы',
];

const spaces = [
  {
    title: 'Основной зал',
    text: 'Здесь играют концерты, идут постановки и разворачивается ночная программа.',
    image: interiorHall,
    alt: 'Основной зал Дома культуры: расписная стена, живые растения и мягкие кресла',
  },
  {
    title: 'Летняя веранда',
    text: 'Открытая площадка на тёплый сезон: сеты до рассвета, длинные ужины и разговоры на воздухе.',
    image: interiorTable,
    alt: 'Сервировка на летней веранде Дома культуры при вечернем свете',
  },
];
---

<BaseLayout
  title={`${site.name} — бар и площадка событий в Екатеринбурге`}
  description={site.description}
  transparentHeader
>
  {/* ---------- Обложка ---------- */}
  <section class="hero">
    <div class="hero__bg">
      <Image
        src={interiorHall}
        alt=""
        widths={[720, 1200, 1800]}
        sizes="100vw"
        quality={72}
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
    </div>

    <div class="hero__inner container">
      <p class="hero__eyebrow eyebrow">{site.positioning}</p>

      <h1 class="hero__title">
        Культура,<br />
        <span class="hero__title-accent">которой так</span><br />
        не хватало
      </h1>

      <p class="hero__lede">
        Бар и площадка событий на Бажова, 193. Сцена для квартирников и концертов,
        театр, музыкальное лото, гастроужины и большая коктейльная карта.
      </p>

      {
        nextUp[0] && (
          <p class="hero__next">
            <span class="hero__next-label">Ближайшее</span>
            <a class="hero__next-link" href={withBase(`/afisha/${nextUp[0].id}`)}>
              {nextUp[0].data.startsAt
                ? `${formatDay(nextUp[0].data.startsAt)} · ${nextUp[0].data.title}`
                : nextUp[0].data.title}
            </a>
          </p>
        )
      }

      <div class="hero__actions">
        <Button href={withBase('/kontakty#bron')} variant="primary" size="lg">
          Забронировать стол
        </Button>
        <Button href={withBase('/afisha')} variant="ghost" size="lg">Смотреть афишу</Button>
      </div>

      <dl class="hero__facts">
        <div class="hero__fact">
          <dt>Адрес</dt>
          <dd>
            <a href={site.contacts.maps} target="_blank" rel="noopener noreferrer">
              {site.contacts.address.city}, {site.contacts.address.streetShort}
            </a>
          </dd>
        </div>
        <div class="hero__fact">
          <dt>Сейчас</dt>
          <dd><OpenStatus /></dd>
        </div>
        <div class="hero__fact">
          <dt>Бронь</dt>
          <dd><a href={site.contacts.phone.href}>{site.contacts.phone.display}</a></dd>
        </div>
      </dl>
    </div>

    <a class="hero__scroll" href="#blizhaishee" aria-label="К ближайшим событиям">
      <span aria-hidden="true"></span>
    </a>
  </section>

  <Proof />

  <Marquee items={ticker} />

  {/* ---------- Ближайшие события ---------- */}
  <section class="section" id="blizhaishee">
    <div class="container">
      <header class="head">
        <div>
          <p class="eyebrow" data-reveal>Афиша</p>
          <h2 class="head__title" data-reveal>Ближайшее</h2>
        </div>
        <div class="head__aside" data-reveal>
          {
            events.length > 0 && (
              <p class="head__note">
                Впереди {events.length}{' '}
                {plural(events.length, ['событие', 'события', 'событий'])}
              </p>
            )
          }
          <Button href={withBase("/afisha")} variant="secondary" size="md">Вся афиша</Button>
        </div>
      </header>

      {
        nextUp.length > 0 ? (
          <ul class="cards" role="list">
            {nextUp.map((event, i) => (
              <li>
                <EventCard event={event} eager={i === 0} />
              </li>
            ))}
          </ul>
        ) : (
          <div class="quiet-note" data-reveal>
            <p>
              Программа на ближайшие недели ещё собирается. Анонсы выходят в Telegram
              раньше, чем где-либо ещё.
            </p>
            <Button href={site.channel.href} variant="secondary" size="md" external>
              Подписаться на анонсы
            </Button>
          </div>
        )
      }
    </div>
  </section>

  <Offers />

  {/* ---------- Что за место ---------- */}
  <section class="section about">
    <div class="container about__grid">
      <div class="about__text" data-reveal>
        <p class="eyebrow">О доме</p>
        <h2 class="about__title">Дом, в который приходят за вечером, а не за столиком</h2>
        <p>
          Дом культуры — это бар, у которого есть сцена. Вечер здесь редко бывает
          фоновым: то квартирник, то постановка, то музыкальное лото, то ужин
          на несколько перемен.
        </p>
        <p>
          Кухня и бар работают на равных: авторские коктейли, сезонные позиции
          и меню, которое меняется вместе с программой.
        </p>
        <div class="about__actions">
          <Button href={withBase("/o-dome")} variant="secondary" size="md">Подробнее о доме</Button>
          <Button href={withBase("/menu")} variant="quiet" size="md">Меню</Button>
        </div>
      </div>

      <figure class="about__figure" data-reveal>
        <Image
          src={interiorTable}
          alt="Сервировка стола в Доме культуры: тёмные цветы, латунь и стекло"
          widths={[480, 720, 960]}
          sizes="(min-width: 60rem) 32rem, 90vw"
          loading="lazy"
          class="about__img"
        />
      </figure>
    </div>
  </section>

  {/* ---------- Пространства ---------- */}
  <section class="section spaces">
    <div class="container">
      <p class="eyebrow" data-reveal>Пространства</p>
      <h2 class="spaces__title" data-reveal>Две сцены под одной крышей</h2>

      <ul class="spaces__list" role="list">
        {
          spaces.map((space, i) => (
            <li class="space" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <div class="space__media">
                <Image
                  src={space.image}
                  alt={space.alt}
                  widths={[480, 760, 1040]}
                  sizes="(min-width: 60rem) 34rem, 92vw"
                  loading="lazy"
                  class="space__img"
                />
              </div>
              <div class="space__body">
                <h3 class="space__title">{space.title}</h3>
                <p class="space__text">{space.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Occasions />

  <SignatureDrinks />

  {/* ---------- Меню ---------- */}
  <section class="section menu-teaser">
    <div class="container menu-teaser__inner">
      <div data-reveal>
        <p class="eyebrow">Бар и кухня</p>
        <h2 class="menu-teaser__title">На кухне</h2>
        <p class="menu-teaser__text">
          Закуски к столу, горячее, паста и десерты. По выходным
          до восьми вечера — бранчи, которые собираешь сам: выбираешь
          основу и начинку или яйца и топпинги.
        </p>
        <div class="menu-teaser__actions">
          <Button href={withBase("/menu")} variant="primary" size="lg">Открыть меню</Button>
          <Button href={site.external.delivery.href} variant="ghost" size="lg" external>
            Доставка
          </Button>
        </div>
      </div>

      <ul class="menu-teaser__cards" role="list">
        <li data-reveal><a href={withBase("/menu#bar-kulturnye-kokteyli")}><span>Бар</span><em>коктейли, вино, крепкое</em></a></li>
        <li data-reveal style="--reveal-delay:80ms"><a href={withBase("/menu#kitchen-cold")}><span>Кухня</span><em>закуски, горячее, десерты</em></a></li>
        <li data-reveal style="--reveal-delay:160ms"><a href={withBase("/bankety")}><span>Банкет</span><em>сеты для компаний</em></a></li>
      </ul>
    </div>
  </section>

  {/* ---------- Банкеты ---------- */}
  <section class="section banquet">
    <div class="container banquet__inner" data-reveal>
      <div>
        <p class="eyebrow">Мероприятия</p>
        <h2 class="banquet__title">Дом можно занять целиком</h2>
        <p class="banquet__text">
          Дни рождения, корпоративы, съёмки и закрытые ужины. Подбираем сет,
          программу и площадку под формат вечера.
        </p>
      </div>
      <div class="banquet__actions">
        <Button href={withBase("/bankety")} variant="primary" size="lg">Банкетное меню</Button>
        <Button href={site.contacts.phone.href} variant="ghost" size="lg">
          {site.contacts.phone.display}
        </Button>
      </div>
    </div>
  </section>

  {/* ---------- Лояльность ---------- */}
  <section class="section loyalty">
    <div class="container loyalty__inner" data-reveal>
      <p class="eyebrow">Лояльность</p>
      <h2 class="loyalty__title">Карта, которая всегда под рукой</h2>
      <p class="loyalty__text">
        Карта, которая всегда под рукой: живёт в телефоне, за визиты копятся бонусы.
      </p>
      <Button href={site.external.loyalty.href} variant="secondary" size="lg" external>
        Оформить карту
      </Button>
    </div>
  </section>
</BaseLayout>

<style>
  /* ================= Обложка ================= */
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-block-size: min(100svh, 60rem);
    padding-block: calc(var(--header-h, 72px) + var(--space-2xl)) var(--space-2xl);
    overflow: hidden;
    /* Шапка прозрачная и стоит поверх — подтягиваем обложку под неё. */
    margin-block-start: calc(-1 * var(--header-h, 72px));
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  /* Двойная заливка: вертикальная — под текст, радиальная — чтобы
     фотография не спорила с заголовком в центре. */
  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        var(--c-ink) 2%,
        color-mix(in oklab, var(--c-ink) 78%, transparent) 38%,
        color-mix(in oklab, var(--c-ink) 40%, transparent) 78%,
        color-mix(in oklab, var(--c-ink) 70%, transparent) 100%
      ),
      radial-gradient(
        120% 90% at 20% 80%,
        color-mix(in oklab, var(--c-void) 65%, transparent),
        transparent 70%
      );
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__title {
    margin-block-start: var(--space-s);
    font-size: var(--step-7);
    font-weight: 200;
    text-transform: uppercase;
    letter-spacing: -0.015em;
  }

  .hero__title-accent {
    color: var(--c-brass);
  }

  .hero__lede {
    max-inline-size: 44ch;
    margin-block-start: var(--space-m);
    font-size: var(--step-1);
    color: var(--c-paper-dim);
  }

  /* Строка с ближайшим событием стоит между обещанием и кнопками:
     она превращает «красиво написано» в «сегодня есть повод прийти». */
  .hero__next {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6em;
    margin-block-start: var(--space-m);
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--c-brass-wash);
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--c-void) 45%, transparent);
    backdrop-filter: blur(6px);
    font-size: var(--step--1);
  }

  .hero__next-label {
    font-family: var(--font-display);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-brass);
  }

  .hero__next-link {
    color: var(--c-paper);
    text-decoration-color: color-mix(in oklab, var(--c-paper) 40%, transparent);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-l);
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-xl);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid color-mix(in oklab, var(--c-paper) 18%, transparent);
  }

  .hero__fact dt {
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-brass);
  }

  .hero__fact dd {
    margin: 0.35em 0 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--step-0);
  }

  .hero__fact a {
    text-decoration: none;
  }

  .hero__scroll {
    position: absolute;
    inset-block-end: var(--space-m);
    inset-inline-end: var(--gutter);
    z-index: 1;
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
  }

  .hero__scroll span {
    inline-size: 10px;
    block-size: 10px;
    border-inline-end: 1px solid var(--c-brass);
    border-block-end: 1px solid var(--c-brass);
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__scroll span {
      animation: nudge 2.4s var(--ease-in-out) infinite;
    }
  }

  @keyframes nudge {
    0%,
    100% {
      transform: rotate(45deg) translate(0, 0);
    }
    50% {
      transform: rotate(45deg) translate(3px, 3px);
    }
  }

  @media (max-width: 40rem) {
    .hero__scroll {
      display: none;
    }
  }

  /* ================= Общие заголовки секций ================= */
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-m);
    margin-block-end: var(--space-l);
  }

  .head__title {
    margin-block-start: var(--space-2xs);
    font-size: var(--step-4);
    text-transform: uppercase;
  }

  .head__aside {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .head__note {
    font-size: var(--step--1);
    color: var(--c-fg-muted);
  }

  .cards {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    margin: 0;
  }

  .quiet-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding: var(--space-l);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
  }
  .quiet-note p {
    max-inline-size: 46ch;
    color: var(--c-paper-dim);
    margin: 0;
  }

  /* ================= О доме ================= */
  .about__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .about__grid {
      grid-template-columns: 1fr 32rem;
      gap: var(--space-2xl);
    }
  }

  .about__title {
    margin-block: var(--space-2xs) var(--space-m);
    font-size: var(--step-4);
    text-transform: uppercase;
  }

  .about__text p {
    max-inline-size: 52ch;
    color: var(--c-paper-dim);
  }
  .about__text p + p {
    margin-block-start: var(--space-s);
  }

  .about__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-l);
  }

  .about__figure {
    margin: 0;
  }

  .about__img {
    inline-size: 100%;
    border-radius: var(--radius-l);
    border: 1px solid var(--c-line);
  }

  /* ================= Пространства ================= */
  .spaces__title {
    margin-block: var(--space-2xs) var(--space-l);
    font-size: var(--step-4);
    text-transform: uppercase;
  }

  .spaces__list {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    margin: 0;
  }

  .space {
    display: grid;
    gap: var(--space-s);
  }

  .space__media {
    overflow: hidden;
    border-radius: var(--radius-l);
    border: 1px solid var(--c-line);
    aspect-ratio: 4 / 3;
  }

  .space__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .space:hover .space__img {
      transform: scale(1.03);
    }
  }

  .space__title {
    font-size: var(--step-2);
    text-transform: uppercase;
  }

  .space__text {
    max-inline-size: 46ch;
    margin-block-start: 0.35em;
    color: var(--c-paper-dim);
  }

  /* ================= Меню ================= */
  .menu-teaser {
    background:
      radial-gradient(80% 120% at 90% 0%, var(--c-green-deep), transparent 60%),
      var(--c-surface);
    border-block: 1px solid var(--c-line);
  }

  .menu-teaser__inner {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 58rem) {
    .menu-teaser__inner {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-2xl);
    }
  }

  .menu-teaser__title {
    margin-block: var(--space-2xs) var(--space-m);
    font-size: var(--step-4);
    text-transform: uppercase;
  }

  .menu-teaser__text {
    max-inline-size: 48ch;
    color: var(--c-paper-dim);
  }

  .menu-teaser__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-l);
  }

  .menu-teaser__cards {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
  }

  .menu-teaser__cards a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-m);
    background: var(--c-ink);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-m);
    text-decoration: none;
    transition:
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }

  .menu-teaser__cards a:hover {
    border-color: var(--c-brass-dim);
    background: var(--c-surface-2);
  }

  .menu-teaser__cards span {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 300;
    text-transform: uppercase;
    color: var(--c-paper);
  }

  .menu-teaser__cards em {
    font-style: normal;
    font-size: var(--step--1);
    color: var(--c-fg-muted);
    text-align: end;
  }

  /* ================= Банкеты ================= */
  .banquet__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-l);
    padding: var(--space-xl);
    background:
      linear-gradient(120deg, var(--c-green-deep), var(--c-surface) 70%);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
  }

  .banquet__title {
    margin-block: var(--space-2xs) var(--space-s);
    font-size: var(--step-4);
    text-transform: uppercase;
  }

  .banquet__text {
    max-inline-size: 44ch;
    color: var(--c-paper-dim);
  }

  .banquet__actions {
    display: flex;
    flex-wrap: wrap;
